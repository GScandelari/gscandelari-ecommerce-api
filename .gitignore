# === Dependências ===
node_modules/
functions/node_modules/

# === Build / artefatos compilados ===
# Anexado ao caminho a partir da raiz do repo (nunca `lib/` puro - isso
# tambem casaria com pastas de codigo-fonte legitimas como web/src/lib/,
# bug ja causado uma vez: ver commit de correcao na Fase 4).
functions/lib/
services/*/lib/
dist/
build/

# === Cobertura de testes ===
coverage/
functions/coverage/

# === Firebase CLI / Emulator Suite ===
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
firestore-debug.*.log
ui-debug.log
pubsub-debug.log
database-debug.log
functions/firebase-debug.log
