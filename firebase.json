{
  "functions": [
    {
      "source": "services/orders",
      "codebase": "orders",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.test.ts",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "source": "services/payments",
      "codebase": "payments",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.test.ts",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    },
    {
      "source": "services/notifications",
      "codebase": "notifications",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "*.test.ts",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/produtos/**", "function": "ordersApi" },
      { "source": "/pedidos/**", "function": "ordersApi" },
      { "source": "/health", "function": "ordersApi" },
      { "source": "/docs/**", "function": "ordersApi" },
      { "source": "/webhooks/stripe", "function": "paymentsApi" }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
