#!/usr/bin/env sh
# Pre-commit hook (Task 1.3.2): bloqueia commit com erro de lint.
# Ativado via `git config core.hooksPath .husky` (ver CONTRIBUTING.md).
#
# Roda o lint de cada pacote do monorepo (3 microsservicos + o front-end
# de testes) - mais rapido que build/test completo, suficiente para pegar
# erros obvios antes do commit; a suite completa roda no CI.
set -e
for dir in services/orders services/payments services/notifications web; do
  echo "==> lint: $dir"
  npm --prefix "$dir" run lint
done
