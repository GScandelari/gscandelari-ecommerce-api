# Copie para .env (ou .env.local) dentro de services/orders/ - ignorado
# pelo git (ver .gitignore da raiz), carregado automaticamente pelo
# Firebase Functions (2a geracao) tanto no emulator quanto em producao.
#
# Fase 3 (Microsservicos) - EM DESENVOLVIMENTO na branch
# feat/fase-3-microservicos, ainda nao mesclada em main. A producao real
# continua rodando exclusivamente o monolito da Fase 1+2 (functions/,
# codebase "default") - ver README.md > "Arquitetura da Fase 3
# (Microsservicos) - em desenvolvimento".

# Ambiente da aplicacao, exposto em GET /health para fins de diagnostico
# (mesmo padrao ja usado em functions/.env.example).
APP_ENV=local

# --- Modulo 9 (comunicacao interna Orders<->Payments, RN16-RN18) - AINDA
# NAO IMPLEMENTADO nesta branch (scaffold + testes TDD "vermelhos" em
# services/orders/test/). As variaveis abaixo refletem os nomes ja
# decididos no BACKLOG.md (Decisao tecnica 2 da Fase 3) para quando o
# Modulo 9 for implementado - nenhuma delas e um segredo de aplicacao
# (sao URLs/config, nao chaves).

# URL publica desta propria function (audience esperado nos ID tokens do
# Google recebidos nas rotas /internal/... - RN18). No emulator, segue o
# padrao http://localhost:<porta-functions>/<project-id>/<regiao>/ordersApi
# (o ID da function e o identificador exportado em src/index.ts, sem
# prefixo automatico de codebase - ver comentario la para o porque).
SELF_BASE_URL=http://localhost:5001/demo-gscandelari-ecommerce-api/us-central1/ordersApi

# URL base do servico Payments, usada pelo cliente HTTP interno
# (services/orders/src/services/payments.internalClient.ts, Task 9.2.2)
# para criar a PaymentIntent via POST /internal/payment-intents (RN16).
PAYMENTS_BASE_URL=http://localhost:5001/demo-gscandelari-ecommerce-api/us-central1/paymentsApi

# E-mail da service account de runtime do Payments (payments-runtime@...),
# unico chamador aceito nas rotas internas /internal/pedidos/... (RN18,
# Task 9.1.2). Em producao, aponta para
# payments-runtime@gscandelari-ecommerce-api.iam.gserviceaccount.com.
ALLOWED_CALLER_SERVICE_ACCOUNT_EMAIL=payments-runtime@gscandelari-ecommerce-api.iam.gserviceaccount.com

# Flag de conveniencia SOMENTE para o Emulator Suite local (o metadata
# server do Google, usado para emitir/validar ID tokens reais, nao existe
# no emulador) - permite pular a validacao real de ID token nas chamadas
# internas durante desenvolvimento. Default false. NUNCA deployar como
# true em producao (ver BACKLOG.md, Decisao tecnica 2 da Fase 3).
SKIP_INTERNAL_AUTH=false
