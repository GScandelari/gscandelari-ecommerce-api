# Config especifica do projeto Firebase real "gscandelari-ecommerce-api"
# (convencao nativa do Firebase Functions 2a geracao: .env.<project-id> so
# e carregado quando o deploy/runtime alvo e esse projeto especifico -
# nunca no emulador, que usa "demo-gscandelari-ecommerce-api"). Nao
# contem segredos (URLs e um e-mail de service account, nao chaves) - os
# segredos de verdade (STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET) continuam
# exclusivamente no Firebase Secret Manager, nunca aqui.
#
# Epico 8.6 (corte de producao) do BACKLOG.md.

APP_ENV=production

# RUNTIME_SERVICE_ACCOUNT_EMAIL (Task 9.1.3/9.1.4): roda a function com a
# SA de menor privilegio dedicada, em vez da SA default do Compute Engine.
RUNTIME_SERVICE_ACCOUNT_EMAIL=payments-runtime@gscandelari-ecommerce-api.iam.gserviceaccount.com

# SELF_BASE_URL/ORDERS_BASE_URL (RN16-RN18): preenchidos com as URLs reais
# do Cloud Run apos o primeiro deploy (passo de bootstrap) - ver
# README.md > "Arquitetura da Fase 3" > "Corte de producao real".
SELF_BASE_URL=PLACEHOLDER_PREENCHIDO_APOS_PRIMEIRO_DEPLOY
ORDERS_BASE_URL=PLACEHOLDER_PREENCHIDO_APOS_PRIMEIRO_DEPLOY

ALLOWED_CALLER_SERVICE_ACCOUNT_EMAIL=orders-runtime@gscandelari-ecommerce-api.iam.gserviceaccount.com
