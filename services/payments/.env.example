# Copie para .env (ou .env.local) dentro de services/payments/ - ignorado
# pelo git (ver .gitignore da raiz), carregado automaticamente pelo
# Firebase Functions (2a geracao) tanto no emulator quanto em producao.
#
# Fase 3 (Microsservicos) - EM DESENVOLVIMENTO na branch
# feat/fase-3-microservicos, ainda nao mesclada em main. A producao real
# continua rodando exclusivamente o monolito da Fase 1+2 (functions/,
# codebase "default") - ver README.md > "Arquitetura da Fase 3
# (Microsservicos) - em desenvolvimento".

APP_ENV=local

# --- Fase 2 (Stripe), migrado para este servico na Fase 3 (Modulo 8,
# Epico 8.3 - AINDA NAO IMPLEMENTADO nesta branch). Mesmas regras ja
# documentadas em functions/.env.example: sempre modo TESTE/sandbox,
# nunca uma chave live. Em producao real, os valores vao para o Firebase
# Secret Manager via `firebase functions:secrets:set`, nunca aqui.

# Chave secreta de TESTE do Stripe (sk_test_...). O segredo real ja esta
# configurado em producao para o monolito (functions/) - quando o corte
# de producao (Epico 8.6) acontecer, sera reconfigurado para o codebase
# "payments".
STRIPE_SECRET_KEY=sk_test_placeholder_substitua_pela_sua_chave_de_teste

# Signing secret do endpoint de webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_placeholder_substitua_pelo_signing_secret

# --- Modulo 9 (comunicacao interna Orders<->Payments, RN16-RN18) - AINDA
# NAO IMPLEMENTADO nesta branch (scaffold + testes TDD "vermelhos" em
# services/payments/test/). Nomes ja decididos no BACKLOG.md (Decisao
# tecnica 2 da Fase 3), espelhando services/orders/.env.example.

# URL publica desta propria function (audience esperado nos ID tokens do
# Google recebidos em /internal/payment-intents - RN18). O ID da function
# e o identificador exportado em src/index.ts, sem prefixo automatico de
# codebase - ver comentario la para o porque.
SELF_BASE_URL=http://localhost:5001/demo-gscandelari-ecommerce-api/us-central1/paymentsApi

# URL base do servico Orders, usada pelo cliente HTTP interno
# (services/payments/src/services/orders.internalClient.ts, Task 9.3.2)
# para efetivar a transicao de status apos um evento de webhook (RN17).
ORDERS_BASE_URL=http://localhost:5001/demo-gscandelari-ecommerce-api/us-central1/ordersApi

# E-mail da service account de runtime do Orders (orders-runtime@...),
# unico chamador aceito na rota interna /internal/payment-intents (RN18,
# Task 9.1.2).
ALLOWED_CALLER_SERVICE_ACCOUNT_EMAIL=orders-runtime@gscandelari-ecommerce-api.iam.gserviceaccount.com

# Flag de conveniencia SOMENTE para o Emulator Suite local (ver
# services/orders/.env.example para a explicacao completa). Default
# false. NUNCA deployar como true em producao.
SKIP_INTERNAL_AUTH=false
