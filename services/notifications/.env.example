# Copie para .env (ou .env.local) dentro de services/notifications/ -
# ignorado pelo git (ver .gitignore da raiz), carregado automaticamente
# pelo Firebase Functions (2a geracao) tanto no emulator quanto em
# producao.
#
# Fase 3 (Microsservicos) - EM DESENVOLVIMENTO na branch
# feat/fase-3-microservicos, ainda nao mesclada em main. A producao real
# continua rodando exclusivamente o monolito da Fase 1+2 (functions/,
# codebase "default") - ver README.md > "Arquitetura da Fase 3
# (Microsservicos) - em desenvolvimento".

APP_ENV=local

# --- Modulo 10 (servico Notifications, RN19) - AINDA NAO IMPLEMENTADO
# nesta branch (scaffold + testes TDD "vermelhos" em
# services/notifications/test/). Task 10.1.2 do BACKLOG.md.
#
# Chave de API do Resend (https://resend.com), SEMPRE em modo
# teste/sandbox (nunca uma chave de dominio verificado/producao real com
# destinatarios reais fora de teste - este projeto e um portfolio de
# demonstracao). Ver README.md > "Segredo novo: RESEND_API_KEY (Resend,
# modo teste/sandbox)" para como obter a chave e como configura-la em
# producao via Firebase Secret Manager.
#
# Sem verificar um dominio proprio no Resend, essa chave so consegue
# enviar e-mail para o endereco cadastrado na propria conta Resend,
# usando o remetente de sandbox onboarding@resend.dev - suficiente para
# o teste manual do fluxo de notificacao (README.md > "Como testar o
# fluxo de notificacao por e-mail manualmente").
RESEND_API_KEY=re_placeholder_substitua_pela_sua_chave_de_teste_sandbox

# Nos testes Jest (services/notifications/test/), o SDK do Resend e
# sempre mockado (test/helpers/mockResend.ts) - o valor real acima nunca
# e usado em CI, so em teste manual local.
