# Carregado automaticamente pelo Vite/Vitest quando MODE=test (vitest define
# isso por padrao). Apenas placeholders SEM significado real - o Auth
# Emulator nao valida estes valores, e os testes (Épico 17.1) mockam
# firebase/auth e o cliente HTTP, entao nenhuma chamada de rede acontece.
# Seguro de versionar (nao e um segredo), analogo ao demais .env.example do
# repositorio.
VITE_FIREBASE_PROJECT_ID=demo-gscandelari-ecommerce-api
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-gscandelari-ecommerce-api.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app-id
VITE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_API_BASE_URL=http://localhost:5001/demo-gscandelari-ecommerce-api/us-central1/ordersApi
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_vitest_placeholder
