# Copie para .env (ou .env.local) dentro de functions/ - esses arquivos
# sao ignorados pelo git e carregados automaticamente pelo Firebase
# Functions (2a geracao) tanto no emulator quanto em producao.

# Ambiente da aplicacao, exposto em GET /health para fins de diagnostico.
APP_ENV=local

# --- Fase 2 (Stripe) - EM DESENVOLVIMENTO, ver README.md > "Integracao de
# pagamento (Stripe)" - implementacao (Modulos 5/6) ainda nao existe. Os
# valores abaixo sao placeholders: NUNCA coloque uma chave real do Stripe
# neste arquivo (ele nao e commitado, mas o padrao do projeto e nunca
# colocar segredo real nem em arquivo local de exemplo). Em producao, os
# valores reais (sempre de modo TESTE/sandbox, nunca live) vao para o
# Firebase Secret Manager via `firebase functions:secrets:set`, nunca aqui.

# Chave secreta de TESTE do Stripe (Developers > API keys, com "Test mode"
# ativado no Dashboard). Sempre comeca com sk_test_, nunca sk_live_.
STRIPE_SECRET_KEY=sk_test_placeholder_substitua_pela_sua_chave_de_teste

# Signing secret do endpoint de webhook (Developers > Webhooks > seu
# endpoint > Signing secret), ou o gerado pelo `stripe listen` do Stripe
# CLI para uso local. Sempre comeca com whsec_.
STRIPE_WEBHOOK_SECRET=whsec_placeholder_substitua_pelo_signing_secret
