{
  "name": "gscandelari-ecommerce-api-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions (2a geracao) + Express + Firestore - gscandelari-ecommerce-api - Fase 1",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "set-admin": "node scripts/setAdminClaim.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:emulator": "npx firebase-tools emulators:exec --only auth,firestore --project demo-gscandelari-ecommerce-api \"npm test\"",
    "test:coverage:emulator": "npx firebase-tools emulators:exec --only auth,firestore --project demo-gscandelari-ecommerce-api \"npm run test:coverage\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "firebase-tools": "^15.25.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.10",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.13.0"
  }
}
